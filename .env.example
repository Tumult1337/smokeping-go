# gosmokeping auto-loads this file at startup (from the directory holding
# --config, then from cwd). Values here are visible to ${NAME} expansion in
# config.json. Real shell env always wins over .env, so local overrides work.

# --- ClickHouse (required for master / standalone) -------------------------
# Native protocol address (host:9000 for plaintext, host:9440 for TLS), an
# account with CREATE/INSERT/SELECT on the configured database, and the
# database name itself. Bootstrap creates the database and the probe_* tables
# on first start, so the user needs CREATE DATABASE on first run only.
CH_ADDR=127.0.0.1:9000
CH_DATABASE=gosmokeping
CH_USERNAME=default
CH_PASSWORD=

# --- Cluster (only if running master/slave) --------------------------------
# Shared bearer token for the /api/v1/cluster/* endpoints. Must match on the
# master and every slave. Leave blank for standalone.
CLUSTER_TOKEN=

# Health-mesh address other nodes probe this slave at (cluster.advertise, via
# ${ADVERTISE_IP} in config.slave.json). On the host-network slave compose,
# `make deploy-slave` autodetects this from the default-route source IP and
# writes it here if it's unset — so host-networked slaves need nothing here.
# Set it manually to override: the reachable overlay address for a separate
# mesh (e.g. WireGuard), or a specific IP on a multi-homed host. Empty (and
# undetectable) means this slave opts out of the health mesh.
#ADVERTISE_IP=

# --- Alert webhooks (optional) ---------------------------------------------
# Remove or comment out whichever channels you don't use.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
