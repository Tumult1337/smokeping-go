{
  "listen": ":8080",
  "interval": "1m0s",
  "pings": 20,
  "storage": {
    "clickhouse": {
      "addr": "127.0.0.1:9000",
      "database": "gosmokeping",
      "username": "",
      "password": "",
      "tls": false,
      "cluster": "",
      "retention": {
        "cycle_days": 0,
        "rtt_days": 0,
        "hop_days": 0,
        "http_days": 0
      },
      "batch": {
        "max_rows": 0,
        "max_interval": ""
      }
    }
  },
  "probes": {
    "dns": {
      "type": "dns",
      "timeout": "3s"
    },
    "curl": {
      "type": "http",
      "timeout": "5s",
      "insecure": true
    },
    "fping": {
      "type": "icmp",
      "timeout": "5s"
    },
    "tcpping": {
      "type": "tcp",
      "timeout": "2s"
    }
  },
  "targets": [
    {
      "group": "network",
      "title": "Network",
      "targets": [
        {
          "name": "cloudflare",
          "host": "1.1.1.1",
          "probe": "fping"
        }
      ]
    },
    {
      "group": "web",
      "title": "Web",
      "targets": [
        {
          "name": "example",
          "url": "https://example.com/",
          "probe": "curl",
          "alerts": [
            "slow"
          ]
        }
      ]
    },
    {
      "group": "services",
      "title": "Services",
      "targets": [
        {
          "name": "api",
          "host": "api.example.com:443",
          "probe": "tcpping"
        }
      ]
    }
  ],
  "alerts": {
    "bigloss": {
      "condition": "loss_pct \u003e 50",
      "sustained": 3,
      "actions": [
        "log"
      ]
    },
    "slow": {
      "condition": "rtt_median \u003e 100ms",
      "sustained": 2,
      "actions": [
        "log"
      ]
    }
  },
  "actions": {
    "log": {
      "type": "log"
    }
  }
}
