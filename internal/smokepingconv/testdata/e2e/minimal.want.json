{
  "listen": ":8080",
  "interval": "30s",
  "pings": 10,
  "storage": {
    "clickhouse": {
      "addr": "127.0.0.1:9000",
      "database": "gosmokeping",
      "username": "",
      "password": "",
      "tls": false,
      "cluster": "",
      "retention": {
        "cycle_days": 0,
        "rtt_days": 0,
        "hop_days": 0,
        "http_days": 0
      },
      "batch": {
        "max_rows": 0,
        "max_interval": ""
      }
    }
  },
  "probes": {
    "fping": {
      "type": "icmp",
      "timeout": "3s"
    }
  },
  "targets": [
    {
      "group": "europe",
      "title": "Europe",
      "targets": [
        {
          "name": "berlin",
          "title": "Berlin",
          "host": "berlin.example.com",
          "probe": "fping"
        }
      ]
    }
  ],
  "actions": {
    "log": {
      "type": "log"
    }
  }
}
